<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_card">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="同行" android:textColor="#17372E" android:textSize="18sp" android:textStyle="bold"
        android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#176553" android:textSize="14sp" android:paddingTop="2dp"/>
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#536A61" android:textSize="12sp"/>
</LinearLayout>
